import java.util.*;

class Solution {
    public int numIslands(char[][] grid) {
        if (grid == null || grid.length == 0) return 0;

        int m = grid.length;
        int n = grid[0].length;
        int islands = 0;

        // Direction arrays for Up, Down, Left, Right
        int[] dRow = {-1, 1, 0, 0};
        int[] dCol = {0, 0, -1, 1};

        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                
                // If we hit an unvisited land cell ('1')
                if (grid[r][c] == '1') {
                    islands++; // Found a new island!

                    // Start BFS to sink all connected land
                    Queue<int[]> queue = new LinkedList<>();
                    queue.add(new int[]{r, c});
                    grid[r][c] = '0'; // Mark as visited immediately when adding to queue

                    while (!queue.isEmpty()) {
                        int[] curr = queue.poll();
                        int currR = curr[0];
                        int currC = curr[1];

                        // Explore 4 neighbors
                        for (int i = 0; i < 4; i++) {
                            int nextR = currR + dRow[i];
                            int nextC = currC + dCol[i];

                            // If neighbor is valid land ('1')
                            if (nextR >= 0 && nextR < m && nextC >= 0 && nextC < n && grid[nextR][nextC] == '1') {
                                grid[nextR][nextC] = '0'; // Sink it immediately so no other cell re-queues it
                                queue.add(new int[]{nextR, nextC});
                            }
                        }
                    }
                }
            }
        }

        return islands;
    }
}
